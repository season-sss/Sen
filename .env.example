# HANEUL — optional backend configuration.
# Without these values the app runs in Local-first mode (all data in this browser).
# The anon key is public by design; Row Level Security in supabase/migrations protects data.
# NEVER put a service_role key or any translation-API secret here (VITE_* values ship to the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: email domain used internally for name#tag accounts (no mail is sent).
# Change it only if your Supabase project rejects the default `.invalid` domain.
# VITE_HANDLE_EMAIL_DOMAIN=users.haneul.invalid
